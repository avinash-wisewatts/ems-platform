# ============================================================================
# WiseWatts EMS -- edge proxy (ADR-023): the only public entry point.
#
#   https://{$EMS_CUSTOMER_HOST}  customers  -> ems-web (frontend),
#                                                customer-api (/api/v1, /auth),
#                                                live-telemetry (/api/live)
#   https://{$EMS_STAFF_HOST}     WiseWatts staff only (IP allowlist)
#                                             -> admin-portal
#
# Customer requests never reach admin-portal: the customer host routes only
# the paths below and answers everything else with 404. The staff host
# refuses every client address outside EMS_STAFF_ALLOWED_CIDRS.
#
# Configuration (root .env of the host; see compose.yaml service `edge`):
#   EMS_CUSTOMER_HOST          customer site address: a hostname such as
#                              app.<domain>, or the host's public IP
#   EMS_STAFF_HOST             staff hostname, e.g. admin.<domain>
#   EMS_CUSTOMER_ALLOWED_CIDRS space-separated client CIDRs allowed on the
#                              customer host (controlled testing); default
#                              everyone (0.0.0.0/0 ::/0)
#   EMS_STAFF_ALLOWED_CIDRS    space-separated client CIDRs allowed on the
#                              staff host; default 127.0.0.1/32 (nobody external)
#   EMS_EDGE_TLS               certificate mode (snippet tls_<mode> below):
#                                internal  Caddy's own CA -- browsers warn
#                                          (default; local / pre-DNS testing)
#                                acme      Let's Encrypt for a hostname
#                                          (needs public DNS to this host)
#                                acme_ip   Let's Encrypt for an IP-address
#                                          site address: 6-day "shortlived"
#                                          profile, renewed automatically
#   EMS_STAFF_EDGE_TLS         certificate mode of the staff host (same values);
#                              default internal, so an unused staff host never
#                              asks a public CA for a certificate
#   EMS_EDGE_HSTS_MAX_AGE      HSTS max-age in seconds (default one year);
#                              a short value for interim setups, e.g. on an
#                              IP address that may later serve something else
#   Both ACME modes validate over ports 80 / 443 from the public internet
#   (http-01 / tls-alpn-01), so those ports must be open to everyone at the
#   firewall; access is then restricted here, by the allowlists, which do not
#   affect certificate validation (handled by Caddy before any route).
#
# remote_ip matches the TCP peer, which is the client because this proxy
# terminates the public connection itself. If a load balancer is ever put in
# front, switch to client_ip with trusted_proxies.
# ============================================================================
{
	admin localhost:2019
	# Clients send no SNI when the URL is an IP address (RFC 6066), so without
	# a default Caddy cannot pick a certificate and aborts the handshake
	# (TLS alert 80) -- every browser fails on https://<ip>/. Use the customer
	# site's certificate for such ClientHellos.
	default_sni {$EMS_CUSTOMER_HOST:customer.invalid}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age={$EMS_EDGE_HSTS_MAX_AGE:31536000}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(tls_internal) {
	tls internal
}

(tls_acme) {
	tls {
		issuer acme
	}
}

(tls_acme_ip) {
	tls {
		issuer acme {
			profile shortlived
		}
	}
}

{$EMS_CUSTOMER_HOST:customer.invalid} {
	import tls_{$EMS_EDGE_TLS:internal}
	import security_headers
	encode zstd gzip

	# `route` keeps this order literal: Caddy would otherwise run every
	# `handle` before a top-level `respond`, bypassing the allowlist.
	route {
		@not_allowed not remote_ip {$EMS_CUSTOMER_ALLOWED_CIDRS:0.0.0.0/0 ::/0}
		respond @not_allowed 403

		# Customer API: sign-in / sign-out and the Analytics API (src.customer_main).
		@customer_api path /api/v1/* /auth/*
		handle @customer_api {
			reverse_proxy customer-api:8070
		}

		# Live asset values (WebSocket). live-telemetry validates the session
		# itself; it accepts the customer session from ADR-023 stage 3.
		@live path /api/live/*
		handle @live {
			reverse_proxy live-telemetry:8090
		}

		# The EMS frontend (static bundle; every data call is authenticated by
		# customer-api).
		handle /app* {
			reverse_proxy ems-web:80
		}

		# `*` is required: a first argument starting with / would be parsed as a
		# path matcher, not the redirect target.
		handle / {
			redir * /app/ 302
		}

		# Nothing else exists on the customer host -- in particular no
		# administration, onboarding, login-page, Grafana or API-docs route.
		handle {
			respond 404
		}
	}
}

{$EMS_STAFF_HOST:staff.invalid} {
	import tls_{$EMS_STAFF_EDGE_TLS:internal}
	import security_headers

	@not_staff not remote_ip {$EMS_STAFF_ALLOWED_CIDRS:127.0.0.1/32}
	respond @not_staff 403

	reverse_proxy admin-portal:8080
}
