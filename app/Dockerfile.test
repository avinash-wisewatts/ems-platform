FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace/app

WORKDIR /workspace

COPY app/requirements.txt /workspace/app/requirements.txt
COPY app/requirements-dev.txt /workspace/app/requirements-dev.txt

RUN pip install \
    --no-cache-dir \
    --requirement /workspace/app/requirements-dev.txt

COPY pytest.ini /workspace/pytest.ini
COPY compose.yaml /workspace/compose.yaml
COPY grafana/plugin-src/wisewatts-live-datasource/src/datasource.ts /workspace/grafana/plugin-src/wisewatts-live-datasource/src/datasource.ts
# Static contract inputs for test_dual_mqtt_broker_ingestion_contract.py.
COPY telegraf/config/telegraf.conf /workspace/telegraf/config/telegraf.conf
COPY telegraf/.env.example /workspace/telegraf/.env.example
COPY app/live-telemetry.env.example /workspace/app/live-telemetry.env.example
COPY scripts/bootstrap /workspace/scripts/bootstrap
COPY app/src /workspace/app/src
COPY app/tests /workspace/app/tests
COPY postgres/ddl /workspace/postgres/ddl
COPY postgres/migrations /workspace/postgres/migrations
COPY postgres/jobs /workspace/postgres/jobs
COPY postgres/restructure_manifest.csv /workspace/postgres/restructure_manifest.csv
# Migration 303 rollback script, executed (rolled back) by
# app/tests/test_routing_forward_floor_late_sweep.py.
COPY postgres/maintenance/303_routing_forward_floor_late_sweep_rollback.sql /workspace/postgres/maintenance/303_routing_forward_floor_late_sweep_rollback.sql
# Migration 305 rollback script, run first by the 303 rollback tests.
COPY postgres/maintenance/305_routing_recovery_queue_rollback.sql /workspace/postgres/maintenance/305_routing_recovery_queue_rollback.sql
# Migration 306 rollback script, executed (rolled back) by
# app/tests/test_demand_reconcile_wide_cadence.py and run first by the 303 rollback tests.
COPY postgres/maintenance/306_demand_reconcile_wide_cadence_rollback.sql /workspace/postgres/maintenance/306_demand_reconcile_wide_cadence_rollback.sql
COPY scripts/test /workspace/scripts/test
# Phase 4 routing generator: spec, template, generator, and committed artifact
# consumed by app/tests/test_routing_generator_contract.py.
COPY scripts/codegen /workspace/scripts/codegen
COPY grafana/dashboards/core /workspace/grafana/dashboards/core

CMD ["pytest", "-q", "-p", "no:cacheprovider", "app/tests"]
