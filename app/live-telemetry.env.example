# Dedicated server-side HiveMQ credentials for the live telemetry subscriber.
# Do not reuse these credentials in Grafana or any browser.
#
# Broker #1 (required).
MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=ems_live_subscriber
MQTT_PASSWORD=replace-me
MQTT_LIVE_CLIENT_ID=ems-live-telemetry
MQTT_TLS=true
EMS_GRAFANA_STREAM_TOKEN=replace-with-a-random-service-token

# Broker #2 (optional -- simultaneous second subscription, NOT failover).
# Supply the FULL set below or leave all of it unset. A partial set makes the
# live-telemetry service fail to start with a clear configuration error.
#
# MQTT2_HOST / MQTT2_PORT are shared with the Telegraf consumer. The
# credentials here are the DEDICATED live-telemetry subscriber identity and
# must be different from the Telegraf consumer's MQTT2_TELEGRAF_* credentials
# (see telegraf/.env.example), mirroring Broker #1's per-path split.
# MQTT2_LIVE_CLIENT_ID must be different from MQTT_LIVE_CLIENT_ID (an MQTT
# broker rejects a second connection that reuses a client id).
# MQTT2_TLS is optional and defaults to MQTT_TLS when omitted.
#MQTT2_HOST=your-second-broker.example.com
#MQTT2_PORT=8883
#MQTT2_LIVE_USERNAME=ems_live_subscriber_2
#MQTT2_LIVE_PASSWORD=replace-me
#MQTT2_LIVE_CLIENT_ID=ems-live-telemetry-b2
#MQTT2_TLS=true
