# Dedicated server-side HiveMQ credentials for the live telemetry subscriber.
# Do not reuse these credentials in Grafana or any browser.
MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=ems_live_subscriber
MQTT_PASSWORD=replace-me
MQTT_LIVE_CLIENT_ID=ems-live-telemetry
MQTT_TLS=true
EMS_GRAFANA_STREAM_TOKEN=replace-with-a-random-service-token
