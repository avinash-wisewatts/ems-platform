# Customer API (src.customer_main, ADR-023) -- copy to app/customer-api.env on
# the host. This file is the customer API container's ONLY configuration: it
# must never contain administration, Grafana or MQTT secrets.

# Database: the least-privilege role from migration 313. Created NOLOGIN; an
# operator enables it once (approved step):
#   ALTER ROLE ems_customer_api LOGIN PASSWORD '<from the secret store>';
EMS_APP_DB_HOST=timescaledb
EMS_APP_DB_PORT=5432
EMS_APP_DB_NAME=ems
EMS_APP_DB_USER=ems_customer_api
EMS_APP_DB_PASSWORD=replace-me

EMS_APP_ENV=staging

# Customer session. Use a NEW random secret (>= 32 characters), different from
# the Administration App's EMS_APP_SESSION_SECRET, so neither host's cookie can
# be verified by the other. The cookie name must not be ems_admin_session.
EMS_APP_SESSION_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
EMS_APP_SESSION_COOKIE_NAME=ems_session
EMS_APP_SESSION_MAX_AGE_SECONDS=28800
# true once the customer host is served over HTTPS by the edge proxy.
EMS_APP_SESSION_HTTPS_ONLY=true

# Whether WiseWatts staff (GLOBAL-scope accounts) may sign in on the customer
# host, e.g. for support. Default false: customer accounts only.
EMS_CUSTOMER_ALLOW_STAFF=false

# Reports tab (staging only, as for the admin portal). The export worker stays
# in the admin portal until the customer API takes over Reports traffic.
EMS_REPORTS_ENABLED=false
EMS_REPORT_EXPORT_WORKER_ENABLED=false
