# WhatsApp sender worker (whatsapp-sender service, ADR-026 A4/A6).
# Copy to app/whatsapp.env on the server only. NEVER commit real values.
# Sending needs all of these AND the database kill switch
# (analytics.alert_whatsapp_delivery_control) AND Legal-approved consent.

EMS_WHATSAPP_SENDING_ENABLED=false

# Meta WhatsApp Business Cloud API (Meta for Developers -> WhatsApp -> API Setup)
EMS_WHATSAPP_ACCESS_TOKEN=
EMS_WHATSAPP_PHONE_NUMBER_ID=
EMS_WHATSAPP_GRAPH_API_VERSION=v26.0

# Approved message template with six body variables:
# {{1}} business  {{2}} alert name  {{3}} asset  {{4}} condition  {{5}} value  {{6}} time
EMS_WHATSAPP_TEMPLATE_NAME=
EMS_WHATSAPP_TEMPLATE_LANGUAGE=en

# Comma-separated E.164 numbers that may receive messages. Staging: WiseWatts-
# controlled test numbers ONLY. Empty = nobody.
EMS_WHATSAPP_RECIPIENT_ALLOWLIST=
EMS_WHATSAPP_ALLOWLIST_DISABLED=false

# Optional tuning
# EMS_WHATSAPP_POLL_SECONDS=5
# EMS_WHATSAPP_BATCH_SIZE=10
# EMS_WHATSAPP_LEASE_SECONDS=300
# EMS_WHATSAPP_REQUEST_TIMEOUT_SECONDS=15
