# Root-level environment file for compose.yaml.
#
# compose.yaml is shared, unchanged, by staging and production (see
# docs/operations/CICD_PIPELINE.md, "BUILD ONCE -> TEST -> PROMOTE THE SAME
# ARTIFACT"). The variables below are the ones compose.yaml itself
# interpolates from this file; every value here is environment-specific and
# must be supplied by each host's own real, untracked root .env.
#
# This is an example/template only. Do NOT put real credentials here, and do
# NOT commit a real .env (see .gitignore).

# Required by the timescaledb healthcheck and by telegraf's PostgreSQL
# output (postgres/outputs.postgresql connection string in
# telegraf/config/telegraf.conf). Environment-specific: set to the real
# TimescaleDB role/database for the host this file lives on.
POSTGRES_USER=
POSTGRES_DB=

# TimescaleDB data volume path. Environment-specific because production's
# TimescaleDB predates this deployment pipeline and already has live data
# bind-mounted at ./postgres/data, while staging's data lives at
# ./postgres/data/pgdata. See docs/operations/CICD_PIPELINE.md, "Compose
# design changes".
TIMESCALEDB_DATA_PATH=./postgres/data/pgdata

# Host bind address for the admin-portal service (container port 8080).
# Defaults safely to 127.0.0.1 (localhost-only) so a host that never sets
# this stays private by default -- this matters because compose.yaml is
# promoted unchanged to production. Staging may explicitly set this to
# 0.0.0.0 in its own untracked root .env if direct host access is
# intentionally required. Production should retain the 127.0.0.1 default
# unless a deliberate production exposure architecture (reverse proxy, TLS,
# authentication) is introduced.
ADMIN_PORTAL_BIND_HOST=127.0.0.1

# Host bind address for the grafana service (container port 3000). Same
# reasoning and same override convention as ADMIN_PORTAL_BIND_HOST above:
# defaults safely to 127.0.0.1; staging may explicitly set 0.0.0.0 in its
# own untracked root .env when intentionally required; production should
# keep the safe default.
GRAFANA_BIND_HOST=127.0.0.1

# Host directory that holds the extracted Phase 8 web frontend bundle,
# bind-mounted READ-ONLY into the admin-portal container at /app/src/spa
# (see compose.yaml). scripts/release/deploy_web_bundle.sh populates it from
# the independent ghcr.io/<owner>/<repo>-web:<git-sha> artifact.
#
# Defaults to ./web-spa (resolved from the compose project directory, i.e.
# <PROJECT_PATH>/web-spa). Leave unset unless a host needs the bundle
# elsewhere; if you override it here, deploy_web_bundle.sh reads the same
# value from this file so the extract target and the mount source stay in
# sync. When the directory does not exist compose creates it empty and the
# frontend simply is not served -- the admin portal is unaffected.
EMS_WEB_SPA_PATH=./web-spa
