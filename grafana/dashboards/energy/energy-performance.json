      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    asset_name AS \"Asset\",\n    asset_type AS \"Type\",\n    SUM(import_consumption_kwh) AS \"MTD kWh\",\n    SUM(valid_import_intervals) AS \"Valid Intervals\",\n    SUM(reset_interval_count) AS \"Resets\",\n    SUM(gap_interval_count) AS \"Gaps\",\n    MAX(last_bucket_start) AS \"Last Bucket\"\nFROM analytics.v_asset_consumption_daily\nWHERE grafana_org_id = ${__org.id}\n  AND site_id::text = '${site}'\n  AND asset_id::text IN (${asset:sqlstring})\n  AND consumption_date >=\n      date_trunc(\n          'month',\n          now() AT TIME ZONE 'Asia/Kolkata'\n      )::date\n  AND consumption_date <=\n      (now() AT TIME ZONE 'Asia/Kolkata')::date\nGROUP BY\n    asset_id,\n    asset_name,\n    asset_type\nORDER BY asset_name;",
          "refId": "A"
        }
      ],
      "title": "Month-to-Date by Operational Asset",
