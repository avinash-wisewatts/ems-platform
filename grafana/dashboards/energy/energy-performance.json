          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    asset_name AS \"Asset\",\n    asset_type AS \"Type\",\n    import_consumption_kwh AS \"Today kWh\",\n    valid_import_intervals AS \"Valid Intervals\",\n    reset_interval_count AS \"Resets\",\n    gap_interval_count AS \"Gaps\",\n    last_bucket_start AS \"Last Bucket\"\nFROM analytics.v_asset_consumption_daily\nWHERE grafana_org_id = ${__org.id}\n  AND site_id::text = '${site}'\n  AND asset_id::text IN (${asset:sqlstring})\n  AND consumption_date =\n      (now() AT TIME ZONE 'Asia/Kolkata')::date\nORDER BY asset_name;",
