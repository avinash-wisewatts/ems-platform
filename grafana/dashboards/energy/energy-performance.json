          "rawQuery": true,
          "rawSql": "SELECT\n    consumption_date::timestamp AS \"time\",\n    asset_name AS metric,\n    import_consumption_kwh AS value\nFROM analytics.v_asset_consumption_daily\nWHERE grafana_org_id = ${__org.id}\n  AND site_id::text = '${site}'\n  AND asset_id::text IN (${asset:sqlstring})\n  AND consumption_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\nORDER BY consumption_date, asset_name;",
          "refId": "A"
        }
