          "rawQuery": true,
          "rawSql": "SELECT\n    bucket_start AS \"time\",\n    asset_name || ' L1' AS metric,\n    voltage_l1_v_avg AS value\nFROM analytics.v_asset_energy_15min\nWHERE grafana_org_id = ${__org.id}\n  AND site_id::text = '${site}'\n  AND asset_id::text = ANY(ARRAY[${asset:sqlstring}]::text[])\n  AND $__timeFilter(bucket_start)\n\nUNION ALL\n\nSELECT\n    bucket_start AS \"time\",\n    asset_name || ' L2' AS metric,\n    voltage_l2_v_avg AS value\nFROM analytics.v_asset_energy_15min\nWHERE grafana_org_id = ${__org.id}\n  AND site_id::text = '${site}'\n  AND asset_id::text = ANY(ARRAY[${asset:sqlstring}]::text[])\n  AND $__timeFilter(bucket_start)\n\nUNION ALL\n\nSELECT\n    bucket_start AS \"time\",\n    asset_name || ' L3' AS metric,\n    voltage_l3_v_avg AS value\nFROM analytics.v_asset_energy_15min\nWHERE grafana_org_id = ${__org.id}\n  AND site_id::text = '${site}'\n  AND asset_id::text = ANY(ARRAY[${asset:sqlstring}]::text[])\n  AND $__timeFilter(bucket_start)\n\nORDER BY 1, 2;",
