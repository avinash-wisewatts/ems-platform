      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(sample_time,'15m'),sum(active_power_kw) AS demand_kw FROM analytics.v_grafana_energy_samples WHERE grafana_org_id = ${__org.id} AND site_id='$site_id'::uuid AND $__timeFilter(sample_time) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
