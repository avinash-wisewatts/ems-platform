    {
      "id": 6,
      "title": "Site demand profile",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
