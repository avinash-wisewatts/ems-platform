      },
      {
        "name": "device_id",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ems-timescaledb"
        },
        "query": "WITH devices AS (\n    SELECT\n        device_name AS __text,\n        device_id::text AS __value\n    FROM analytics.v_grafana_devices\n    WHERE grafana_org_id = ${__org.id}\n      AND site_id::text = '$site_id'\n)\nSELECT __text, __value\nFROM devices\n\nUNION ALL\n\nSELECT\n    'No devices configured for this site' AS __text,\n    '00000000-0000-0000-0000-000000000000' AS __value\nWHERE NOT EXISTS (SELECT 1 FROM devices)\n\nORDER BY 1",
        "definition": "WITH devices AS (\n    SELECT\n        device_name AS __text,\n        device_id::text AS __value\n    FROM analytics.v_grafana_devices\n    WHERE grafana_org_id = ${__org.id}\n      AND site_id::text = '$site_id'\n)\nSELECT __text, __value\nFROM devices\n\nUNION ALL\n\nSELECT\n    'No devices configured for this site' AS __text,\n    '00000000-0000-0000-0000-000000000000' AS __value\nWHERE NOT EXISTS (SELECT 1 FROM devices)\n\nORDER BY 1",
