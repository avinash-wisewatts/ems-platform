          "uid": "ems-timescaledb"
        },
        "query": "SELECT site_name AS __text, site_id AS __value FROM analytics.v_grafana_sites WHERE grafana_org_id = ${__org.id} ORDER BY site_name",
        "definition": "SELECT site_name AS __text, site_id AS __value FROM analytics.v_grafana_sites WHERE grafana_org_id = ${__org.id} ORDER BY site_name",
        "refresh": 1,
        "multi": false,
