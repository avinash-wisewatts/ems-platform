    {
      "id": 6,
      "title": "Active alarms by site",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ems-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.site_name,a.severity,count(*) AS alarms FROM analytics.v_grafana_active_alarms a JOIN analytics.v_grafana_sites s ON s.grafana_org_id=a.grafana_org_id AND s.site_id=a.site_id WHERE a.grafana_org_id = ${__org.id} AND ('$__all' IN (${severity:sqlstring}) OR a.severity IN (${severity:sqlstring})) GROUP BY s.site_name,a.severity ORDER BY alarms DESC",
          "refId": "A"
        }
      ],
      "description": "",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
