            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT severity,site_id,entity_type,entity_name,alarm_code,alarm_message,detected_at,last_observed_at FROM analytics.v_grafana_active_alarms WHERE grafana_org_id = ${__org.id} AND ('$__all' IN (${severity:sqlstring}) OR severity IN (${severity:sqlstring})) ORDER BY CASE severity WHEN 'CRITICAL' THEN 1 WHEN 'HIGH' THEN 2 WHEN 'MEDIUM' THEN 3 ELSE 4 END,last_observed_at DESC",
          "refId": "A"
        }
