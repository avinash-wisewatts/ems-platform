    {
      "id": 6,
      "title": "Portfolio demand",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ems-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(sample_time,'15m'), sum(active_power_kw) AS demand_kw FROM analytics.v_grafana_energy_samples WHERE grafana_org_id = ${__org.id} AND $__timeFilter(sample_time) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Sites requiring attention",
      "type": "table",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ems-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.site_name,s.sector_name,s.asset_count,s.device_count,count(a.alarm_key) AS active_alarms FROM analytics.v_grafana_sites s LEFT JOIN analytics.v_grafana_active_alarms a ON a.grafana_org_id=s.grafana_org_id AND a.site_id=s.site_id WHERE s.grafana_org_id = ${__org.id} GROUP BY s.site_name,s.sector_name,s.asset_count,s.device_count ORDER BY active_alarms DESC,s.site_name",
          "refId": "A"
        }
      ],
      "description": "",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
