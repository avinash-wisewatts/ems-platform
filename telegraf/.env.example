# ============================================================================
# Telegraf environment file for compose.yaml (telegraf service).
#
# compose.yaml is shared, unchanged, by staging and production. The real file
# lives at telegraf/.env on each host, is environment-specific, and is NEVER
# committed (see .gitignore). This is a placeholder template only -- do NOT
# put real credentials or real broker hostnames here.
#
# telegraf/config/telegraf.conf interpolates ${VAR} from this file (merged
# with the root .env) at container start.
# ============================================================================

# ---------------------------------------------------------------------------
# MQTT Broker #1 -- historical ingestion consumer (required).
# ---------------------------------------------------------------------------
MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
# Retained for scripts/bootstrap validation compatibility. telegraf.conf
# hard-codes its topic patterns; this value is not consumed by the consumer.
MQTT_TOPIC=wwems/v1/+/+/+/telemetry
MQTT_USERNAME=wisewatts_ems_telegraf
MQTT_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# MQTT Broker #2 -- second historical ingestion consumer, consumed
# SIMULTANEOUSLY with Broker #1 (a separate [[inputs.mqtt_consumer]] in
# telegraf.conf, not a failover entry). Required on any host that runs the
# dual-broker configuration; supply the full set below.
# ---------------------------------------------------------------------------
MQTT2_HOST=your-second-broker.example.com
MQTT2_PORT=8883
MQTT2_USERNAME=wisewatts_ems_telegraf_2
MQTT2_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Dedicated least-privilege PostgreSQL account for Telegraf's raw-capture
# output. POSTGRES_DB must match the root .env database.
# ---------------------------------------------------------------------------
POSTGRES_USER=telegraf_writer
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=ems
